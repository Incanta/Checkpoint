{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    // ---- src/app ----
    {
      "name": "API",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/app",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["dev"]
    },

    // ---- src/core ----
    {
      "name": "Backend",
      "type": "lldb",
      "request": "launch",
      "program": "c:/Program Files/nodejs/node.exe",
      "args": ["--inspect=0.0.0.0:9230", "lib/index.js"],
      "cwd": "${workspaceFolder}/src/core/server",
      "env": {
        "NODE_CONFIG_DIR": "${workspaceFolder}/src/core/server/config",
        "NODE_CONFIG_ENV": "default"
      }
    },
    {
      "name": "Debug C++ for Daemon",
      "type": "lldb",
      "request": "launch",
      "program": "c:/Program Files/nodejs/node.exe",
      "args": ["--inspect=0.0.0.0:9231", "lib/bin.js"],
      "cwd": "${workspaceFolder}/src/core/daemon",
      "env": {
        "NODE_CONFIG_DIR": "${workspaceFolder}/src/core/daemon/config"
      },
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      }
    },
    {
      "name": "Attach Server",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "skipFiles": ["<node_internals>/**"],
      "localRoot": "${workspaceFolder}/src/core/server"
    },
    {
      "name": "Attach Daemon",
      "type": "node",
      "request": "attach",
      "port": 9231,
      "skipFiles": ["<node_internals>/**"],
      "localRoot": "${workspaceFolder}/src/core/daemon"
    },

    // ---- src/clients/desktop ----
    {
      "name": "Electron Main",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/clients/desktop",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["dev"],
      "env": {
        "USE_MOCK_DATA": "false",
        "REMOTE_DEBUGGING_PORT": "19229"
      }
    },
    {
      "name": "Electron Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 19229,
      "timeout": 60000,
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**",
        "${workspaceFolder}/src/clients/desktop/node_modules/**",
        "${workspaceFolder}/src/clients/desktop/dist/main/**"
      ],
      "restart": true
    },

    // ---- src/clients/vscode ----
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/src/clients/vscode"
      ],
      "outFiles": ["${workspaceFolder}/src/clients/vscode/dist/**/*.js"],
      "preLaunchTask": "Build VS Code Extension"
    }
  ],
  "compounds": [
    {
      "name": "Server Webapp",
      "configurations": ["API", "Backend"],
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      }
    },
    {
      "name": "Attach Core",
      "configurations": ["Attach Daemon", "Attach Server"],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      }
    },
    {
      "name": "Desktop App",
      "configurations": ["Electron Main"],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      }
    }
  ]
}
